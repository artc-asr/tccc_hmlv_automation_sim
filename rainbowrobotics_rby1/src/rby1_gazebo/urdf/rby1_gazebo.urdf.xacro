<?xml version="1.0"?>
<!-- RB-Y1 for Gazebo Harmonic: description + ros2_control + sensors. -->
<robot name="rby1" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="controllers_file" default="$(find rby1_gazebo)/config/rby1_controllers.yaml"/>

  <xacro:include filename="$(find rby1_description)/urdf/rby1.urdf.xacro"/>

  <!-- ===================== ros2_control ===================== -->
  <xacro:macro name="position_joint" params="name initial:=0.0">
    <joint name="${name}">
      <command_interface name="position">
        <param name="initial_value">${initial}</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">${initial}</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="velocity_joint" params="name">
    <joint name="${name}">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </xacro:macro>

  <ros2_control name="RBY1GazeboSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <xacro:velocity_joint name="right_wheel"/>
    <xacro:velocity_joint name="left_wheel"/>

    <xacro:position_joint name="torso_0"/>
    <xacro:position_joint name="torso_1"/>
    <xacro:position_joint name="torso_2"/>
    <xacro:position_joint name="torso_3"/>
    <xacro:position_joint name="torso_4"/>
    <xacro:position_joint name="torso_5"/>

    <xacro:position_joint name="right_arm_0"/>
    <xacro:position_joint name="right_arm_1"/>
    <xacro:position_joint name="right_arm_2"/>
    <xacro:position_joint name="right_arm_3"/>
    <xacro:position_joint name="right_arm_4"/>
    <xacro:position_joint name="right_arm_5"/>
    <xacro:position_joint name="right_arm_6"/>

    <xacro:position_joint name="left_arm_0"/>
    <xacro:position_joint name="left_arm_1"/>
    <xacro:position_joint name="left_arm_2"/>
    <xacro:position_joint name="left_arm_3"/>
    <xacro:position_joint name="left_arm_4"/>
    <xacro:position_joint name="left_arm_5"/>
    <xacro:position_joint name="left_arm_6"/>

    <xacro:position_joint name="head_0"/>
    <xacro:position_joint name="head_1"/>

    <xacro:position_joint name="gripper_finger_r1"/>
    <xacro:position_joint name="gripper_finger_r2"/>
    <xacro:position_joint name="gripper_finger_l1"/>
    <xacro:position_joint name="gripper_finger_l2"/>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg controllers_file)</parameters>
      <ros>
        <remapping>/diff_drive_controller/cmd_vel_unstamped:=/cmd_vel</remapping>
        <remapping>/diff_drive_controller/odom:=/odom</remapping>
      </ros>
    </plugin>
  </gazebo>

  <!-- ===================== contact properties ===================== -->
  <!-- Drive wheels: high friction. -->
  <xacro:macro name="wheel_contact" params="link">
    <gazebo reference="${link}">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <kp>1e6</kp>
      <kd>100</kd>
    </gazebo>
  </xacro:macro>
  <xacro:wheel_contact link="wheel_r"/>
  <xacro:wheel_contact link="wheel_l"/>

  <!-- Base: frictionless so the rear caster spheres slide freely. -->
  <gazebo reference="base">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>

  <!-- Gripper fingers: grippy for grasping. -->
  <xacro:macro name="finger_contact" params="link">
    <gazebo reference="${link}">
      <mu1>1.5</mu1>
      <mu2>1.5</mu2>
    </gazebo>
  </xacro:macro>
  <xacro:finger_contact link="ee_finger_r1"/>
  <xacro:finger_contact link="ee_finger_r2"/>
  <xacro:finger_contact link="ee_finger_l1"/>
  <xacro:finger_contact link="ee_finger_l2"/>

  <!-- ===================== sensors ===================== -->
  <gazebo reference="head_camera_link">
    <sensor name="head_camera" type="rgbd_camera">
      <topic>head_camera</topic>
      <gz_frame_id>head_camera_optical_frame</gz_frame_id>
      <update_rate>15</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <camera>
        <horizontal_fov>1.2</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>10.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <topic>imu</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <update_rate>100</update_rate>
      <always_on>true</always_on>
    </sensor>
  </gazebo>

</robot>
