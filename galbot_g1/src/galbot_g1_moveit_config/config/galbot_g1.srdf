    <!-- Hand edits (keep when regenerating): the wrist's two bend axes (joint6,
         joint7) intersect, and link5's and link7's convex collision hulls both
         wrap that joint, so they overlap as soon as the wrist bends. Within the
         joint limits (joint6 about 47 deg, joint7 about 88 deg) the hand can't
         reach the forearm itself; the gripper links against link5 stay checked.
         Without this, no top-down grasp beyond about 0.8 m is collision-free. -->
    <disable_collisions link1="left_arm_link5" link2="left_arm_link7" reason="User"/>
    <disable_collisions link1="right_arm_link5" link2="right_arm_link7" reason="User"/>
</robot>
