<?xml version="1.0"?>
<sdf version="1.9">
  <world name="galbot_table">
    <physics name="2ms" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <dart>
        <!-- Bullet is much faster than the default FCL for the robot's mesh colliders. -->
        <collision_detector>bullet</collision_detector>
      </dart>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.75 0.8 0.85 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Work table in front of the robot, top at 0.72 m. -->
    <model name="table">
      <static>true</static>
      <pose>0.85 0 0 0 0 0</pose>
      <link name="link">
        <collision name="top_collision">
          <pose>0 0 0.7 0 0 0</pose>
          <geometry><box><size>0.6 1.2 0.04</size></box></geometry>
        </collision>
        <visual name="top_visual">
          <pose>0 0 0.7 0 0 0</pose>
          <geometry><box><size>0.6 1.2 0.04</size></box></geometry>
          <material>
            <ambient>0.55 0.4 0.28 1</ambient>
            <diffuse>0.55 0.4 0.28 1</diffuse>
          </material>
        </visual>
        <collision name="base_collision">
          <pose>0.1 0 0.34 0 0 0</pose>
          <geometry><box><size>0.3 1.0 0.68</size></box></geometry>
        </collision>
        <visual name="base_visual">
          <pose>0.1 0 0.34 0 0 0</pose>
          <geometry><box><size>0.3 1.0 0.68</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="red_cube">
      <pose>0.65 0.2 0.745 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia><ixx>5.2e-6</ixx><iyy>5.2e-6</iyy><izz>5.2e-6</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="blue_can">
      <pose>0.65 -0.2 0.78 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.1</mass>
          <inertia><ixx>7.7e-5</ixx><iyy>7.7e-5</iyy><izz>3.1e-5</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.025</radius><length>0.12</length></cylinder></geometry>
          <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.025</radius><length>0.12</length></cylinder></geometry>
          <material><ambient>0.1 0.2 0.8 1</ambient><diffuse>0.1 0.2 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="green_box">
      <pose>0.75 0 0.76 0 0 0.4</pose>
      <link name="link">
        <inertial>
          <mass>0.2</mass>
          <inertia><ixx>2.1e-4</ixx><iyy>1.4e-4</iyy><izz>2.1e-4</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.08 0.12 0.08</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.08 0.12 0.08</size></box></geometry>
          <material><ambient>0.1 0.7 0.2 1</ambient><diffuse>0.1 0.7 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
