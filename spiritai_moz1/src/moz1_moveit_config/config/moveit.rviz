# ============================================================================
# moveit.rviz — RViz layout for real.launch.py and demo.launch.py.
#
# ⚠ THIS FILE IS REWRITTEN BY RVIZ. Ctrl+S in RViz saves to whatever path was
# passed with -d, which is the INSTALL copy
# (moz1_manip_ws/install/moz1_moveit_config/share/moz1_moveit_config/config/),
# NOT this one — so a saved layout is lost on the next `colcon build` unless it
# is copied back here. That is what happened on 2026-08-08; this file is the
# result of that copy.
#
# ⚠ RViz's writer STRIPS EVERY YAML COMMENT. The comments in this file will
# vanish the next time you Ctrl+S. Workflow that survives:
#     1. arrange RViz, Ctrl+S            (writes the install copy, no comments)
#     2. cp install/.../moveit.rviz  src/.../moveit.rviz
#     3. re-add the comment blocks below
#     4. colcon build --packages-select moz1_moveit_config
# Keep the comments few and load-bearing for exactly this reason.
# ============================================================================
Panels:
  - Class: rviz_common/Displays
    Help Height: 70
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /MotionPlanning1
      Splitter Ratio: 0.5
    Tree Height: 369
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.029999999329447746
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 10
      Reference Frame: <Fixed Frame>
      Value: true
    # 🔴 THIS IS THE REAL SPEED KNOB FOR ANYTHING PLANNED FROM RVIZ.
    # Paired with Velocity_Scaling_Factor near the end of this display block.
    # These two are the Planning-tab spinboxes, and RViz sends them with EVERY
    # plan request — which OVERRIDES joint_limits_real.yaml's
    # default_{velocity,acceleration}_scaling_factor (a request field only falls
    # back to the YAML default when it is left at 0). Measured: an explicit
    # request value changes the trajectory duration while the YAML default is
    # held constant (§12.21).
    # So effective RViz speed = per-joint max_velocity x THIS, and the YAML
    # scaling factor is a no-op for RViz-driven motion. 0.1 here means 10 % of
    # the limits in joint_limits_real.yaml.
    # Kept in sync with joint_limits_real.yaml's
    # default_acceleration_scaling_factor (0.5) — set 2026-08-08.
    - Acceleration_Scaling_Factor: 0.5
      Class: moveit_rviz_plugin/MotionPlanning
      Enabled: true
      Move Group Namespace: ""
      MoveIt_Allow_Approximate_IK: false
      MoveIt_Allow_External_Program: false
      MoveIt_Allow_Replanning: false
      MoveIt_Allow_Sensor_Positioning: false
      MoveIt_Planning_Attempts: 10
      MoveIt_Planning_Time: 5
      MoveIt_Use_Cartesian_Path: false
      MoveIt_Use_Constraint_Aware_IK: false
      MoveIt_Workspace:
        Center:
          X: 0
          Y: 0
          Z: 0
        Size:
          X: 2
          Y: 2
          Z: 2
      Name: MotionPlanning
      Planned Path:
        Color Enabled: false
        Interrupt Display: false
        Links:
          All Links Enabled: true
          Expand Joint Details: false
          Expand Link Details: false
          Expand Tree: false
          Link Tree Style: Links in Alphabetic Order
          base_footprint:
            Alpha: 1
            Show Axes: false
            Show Trail: false
          base_link:
            Alpha: 1
