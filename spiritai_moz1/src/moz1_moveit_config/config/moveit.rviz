      # and it OVERRIDES joint_limits_real.yaml's default_velocity_scaling_factor.
      # 0.1 = 10 % of the per-joint limits. Change together with the acceleration
      # factor above, or the profile stays acceleration-bound.
      # Kept in sync with joint_limits_real.yaml's
      # default_velocity_scaling_factor (1.0) — set 2026-08-08. 1.0 = the full
      # per-joint max_velocity envelope; RViz's spinbox can only go DOWN from here.
      Velocity_Scaling_Factor: 1.0
