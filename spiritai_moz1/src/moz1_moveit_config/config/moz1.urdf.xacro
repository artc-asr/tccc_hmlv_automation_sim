<?xml version="1.0"?>
<!-- ========================================================================
     moz1.urdf.xacro (moz1_moveit_config) - the description PLUS a ros2_control
     block backed by mock_components/GenericSystem.

     mock_components is a PURE SIMULATION hardware interface: it loops commanded
     positions straight back to state, so MoveIt's fake controllers can "execute"
     trajectories with NO real hardware and NO real motion. This is what makes
     `demo.launch.py` safe.

     >>> TO MOVE THE REAL ROBOT, DO NOT EDIT THIS FILE. <<<
         Still true, but the reason CHANGED on 2026-08-05 (Phase 6a): there is now
         a real ros2_control hardware plugin, and it lives in its own description:

             moz1_driver_ws/src/moz1_bringup/urdf/moz1_ros2_control.xacro
             ros2 launch moz1_bringup    moz1_control.launch.py   # driver
             ros2 launch moz1_moveit_config real.launch.py        # MoveIt on real HW

         Keep THIS file mock-only so demo.launch.py stays a safe simulation.
         moz1_moveit_bridge's SDK path is superseded by
         joint_trajectory_controller against moz1_hardware, and those nodes now
         refuse real motion whenever /controller_manager is running (§6.3: exactly
         one process may own the SDK connection).

     Joints exposed to ros2_control: the two 7-DOF arms, the placeholder
     grippers, and the torso (held at home so RViz shows a sensible pose).
     Wheels and head are intentionally excluded.
     ===================================================================== -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="moz1">

  <!-- The actual robot geometry (CAD-faithful arms/torso + placeholders). -->
  <xacro:include filename="$(find moz1_description)/urdf/moz1.urdf.xacro"/>

  <!-- One position-controlled mock joint with an initial hold value. -->
  <xacro:macro name="mock_joint" params="name init">
    <joint name="${name}">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">${init}</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
  </xacro:macro>

  <ros2_control name="moz1_mock_system" type="system">
    <hardware>
      <!-- SIMULATION ONLY - mirrors commands to states. No hardware I/O. -->
      <plugin>mock_components/GenericSystem</plugin>
    </hardware>

    <!-- Torso, at home = [0, 60, -90, 30, 0, 0] deg.
         ⚠ CORRECTED 2026-08-08: was [30, 0, 0, 30, 0, 0] deg, which was wrong
         (see robot.yaml). Sim now STARTS where the real robot actually rests, so
         a torso plan tried in demo.launch.py first exercises the same motion it
         will on hardware — which is the whole point of trying it in sim. A
         torso_controller now exists here too (ros2_controllers.yaml), so this is
         no longer "held at home; no controller commands it". §12.22. -->
    <xacro:mock_joint name="LegWaist-0" init="0.0"/>
    <xacro:mock_joint name="LegWaist-1" init="1.0471975512"/>
    <xacro:mock_joint name="LegWaist-2" init="-1.5707963268"/>
    <xacro:mock_joint name="LegWaist-3" init="0.5235987756"/>
    <xacro:mock_joint name="LegWaist-4" init="0.0"/>
    <xacro:mock_joint name="LegWaist-5" init="0.0"/>

    <!-- Left arm (home pose). -->
    <xacro:mock_joint name="LeftArm-0" init="-0.1570796327"/>
    <xacro:mock_joint name="LeftArm-1" init="-0.8726646260"/>
    <xacro:mock_joint name="LeftArm-2" init="-0.3490658504"/>
    <xacro:mock_joint name="LeftArm-3" init="-1.5707963268"/>
    <xacro:mock_joint name="LeftArm-4" init="-0.6108652381"/>
    <xacro:mock_joint name="LeftArm-5" init="0.1396263402"/>
    <xacro:mock_joint name="LeftArm-6" init="-0.1221730476"/>

    <!-- Right arm (home pose). -->
    <xacro:mock_joint name="RightArm-0" init="0.1570796327"/>
    <xacro:mock_joint name="RightArm-1" init="-0.8726646260"/>
    <xacro:mock_joint name="RightArm-2" init="0.3490658504"/>
    <xacro:mock_joint name="RightArm-3" init="1.5707963268"/>
    <xacro:mock_joint name="RightArm-4" init="0.6108652381"/>
    <xacro:mock_joint name="RightArm-5" init="0.1396263402"/>
    <xacro:mock_joint name="RightArm-6" init="0.1221730476"/>

    <!-- Grippers at half stroke (0..0.12 m = SDK units, 0.12 open). §12.17. -->
    <xacro:mock_joint name="left_gripper_joint"  init="0.06"/>
    <xacro:mock_joint name="right_gripper_joint" init="0.06"/>
  </ros2_control>

</robot>
