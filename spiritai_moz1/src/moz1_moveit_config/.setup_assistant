# Hand-written (not generated by the MoveIt Setup Assistant). Tells
# MoveItConfigsBuilder where the URDF/SRDF live so it stops warning.
#
# NOTE: the URDF below is the moz1_moveit_config wrapper (config/moz1.urdf.xacro)
# which adds the mock_components ros2_control block on top of moz1_description.
# MoveItConfigsBuilder auto-detects that same path, so this is mostly for the SRDF.
moveit_setup_assistant_config:
  urdf:
    package: moz1_moveit_config
    relative_path: config/moz1.urdf.xacro
  srdf:
    relative_path: config/moz1.srdf
