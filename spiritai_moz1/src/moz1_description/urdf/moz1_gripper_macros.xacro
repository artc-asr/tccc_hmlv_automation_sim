<?xml version="1.0"?>
<!-- ========================================================================
     moz1_gripper_macros.xacro - REAL gripper CAD (AgiBot / OmniPicker).

     GENERATED by scripts/generate_gripper_macro.py from the vendor gripper
     package (robot_description/urdf/robot_urdf.xacro). Edit that script, not
     this file, and re-run scripts/verify_gripper.py afterwards.

     Replaces the earlier PLACEHOLDER box gripper. Geometry and every length
     come from the vendor CAD; the coupling below is SOLVED from those lengths.

     MECHANISM. Each finger is a four-bar whose COUPLER IS THE FINGERTIP - the
     fingertip is pinned to both bars, so its angle is determined by loop
     closure, not free:
         ground (the two bar pivots on the body)  17.500 mm
         bar 1  ${side}_gripper_*1_link           49.051 mm
         coupler (the fingertip's two pins)       10.400 mm
         bar 2  ${side}_gripper_*_loop_link       33.062 mm
     The real linkage is a FIVE-bar (2 DOF): the inner link carries a SPRING
     that gives the gripper its adaptive/underactuated behaviour. In free
     motion the spring rests against its stop, so that link is modelled FIXED
     and the finger is a rigid 1-DOF four-bar. The spring's travel is the
     contact-dependent second DOF and is deliberately NOT modelled - a mimic
     tree cannot express it, and this description is the free-motion pose,
     which is what visualisation and collision checking need. (Modelling it as
     a second dependent variable was tried and made the pin worse: 1.84 mm vs
     1.40 mm at the same opening.)

     COUPLING. <mimic> is linear and a four-bar is not, so the coupler and
     bar-2 angles are minimax-linearised over the working stroke. Residual
     error at the closing pin is ~1.1 mm: the pin sits slightly off-centre in
     its hole but never leaves it.

     STROKE: bar 1 -1.76 deg (closed) .. 45.00 deg (open).
       - closed = the claws just touching, calibrated against the real meshes
         with a SIGNED gap. Always use a signed measure: a nearest-vertex
         distance cannot detect interpenetration and reported a harmless
         0.15 mm on a pose whose claws actually overlapped by 9.9 mm.
       - T_CLOSED must be RE-CALIBRATED whenever T_OPEN changes.

     COMMAND vs REAL JAW GAP. ${jname} carries the SDK's 0..0.12 value
     directly (CLAUDE.md 12.17), but that value is NOT the true gap in metres:
       1. REACH - scanning the full 2-DOF space this mechanism peaks at
          100.6 mm and never reaches 120 mm in any pose. Either this CAD is a
          smaller variant than the gripper on the robot, or the SDK's 0.12 is
          not literally metres. Worth confirming with the vendor.
       2. LINEARITY - gap-vs-angle is sinusoidal while <mimic> is linear, so no
          linear mimic chain can make gap(w) == w; optimising every coefficient
          bottoms out at ~8 mm of mismatch mid-stroke.
     The exact cmd -> gap curve is in reference/cmd_to_gap.csv so the driver can
     invert it. Do NOT stretch the linkage to hit 0.12 - doing that is what
     dislocated the pin in earlier attempts.

     The ee_link->flange correction (-0.0101 0.0 0.0005) exists because
     moz1_description's ${side}_ee_link is a placeholder at [0,0,-0.05] while
     the vendor arm-end frame is [-0.0101,0,-0.0495] (CLAUDE.md 12.33). Set it
     to zero once ee_link is corrected. This is the gripper MOUNT, not a TCP.
     ===================================================================== -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- side : "left" / "right" ; jname : the single actuated jaw joint -->
  <xacro:macro name="moz1_gripper" params="side jname parent:=''">
    <xacro:property name="mount_parent"
                    value="${parent if parent else side + '_ee_link'}"/>

    <!-- Gripper body. Mount = the ee_link->flange correction, then
         180 deg about Y: the flange's local -Z is the arm's outward
         axis while the gripper's +Z points at the fingers, and the
         operator confirmed on the robot that it also needs a half turn
         about the mount's own axis. The two compose to rpy=(0,pi,0).
         Any mounting standoff along the axis is still UNVERIFIED. -->
    <link name="${side}_gripper_base_link">
      <inertial>
        <origin xyz="-5.52e-05 1.2341e-05 0.03296193" rpy="0 0 0"/>
        <mass value="0.25641368"/>
        <inertia ixx="0.00046351" ixy="-1e-08" ixz="-1.04e-06" iyy="0.00044525" iyz="-5e-08" izz="0.00010438"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="package://moz1_description/meshes/gripper_base.STL"/></geometry>
        <material name="moz1_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="package://moz1_description/meshes/gripper_base.STL"/></geometry>
      </collision>
    </link>
    <joint name="${side}_gripper_mount_joint" type="fixed">
      <origin xyz="-0.0101 0.0 0.0005" rpy="0 ${pi} 0"/>
      <parent link="${mount_parent}"/>
      <child  link="${side}_gripper_base_link"/>
    </joint>

    <!-- The ONE actuated DOF. Its value is the SDK's gripper command,
         0.0 (closed) .. 0.12 (open), carried directly with no scaling so
         moz1_hardware can pass SDK units straight through. Every linkage joint
         below <mimic>s this one, so there is exactly one commandable joint per
         gripper. The link it drives carries no geometry: the prismatic travel
         is notional, the visible motion comes from the mimicking revolutes. -->
    <link name="${side}_gripper_actuator_link"/>
    <joint name="${jname}" type="prismatic">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="${side}_gripper_base_link"/>
      <child  link="${side}_gripper_actuator_link"/>
      <axis xyz="0 0 1"/>
      <limit lower="0.0" upper="0.12" effort="20.0" velocity="0.1"/>
    </joint>

    <!-- ===== narrow finger ===== -->
    <link name="${side}_gripper_narrow1_link">
      <inertial>
        <origin xyz="0.0094685 0.0068806 6.5437e-05" rpy="0 0 0"/>
        <mass value="0.025428"/>
        <inertia ixx="1.9574e-06" ixy="-4.2911e-07" ixz="-3.7111e-11" iyy="2.3919e-06" iyz="-3.008e-10" izz="1.5501e-06"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="package://moz1_description/meshes/gripper_narrow1.STL"/></geometry>
        <material name="moz1_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="package://moz1_description/meshes/gripper_narrow1.STL"/></geometry>
      </collision>
    </link>
    <joint name="${side}_gripper_narrow1_joint" type="revolute">
      <origin xyz="0 -0.0195 0.0565" rpy="-2.9951 -1.5708 -0.15964"/>
      <parent link="${side}_gripper_base_link"/>
      <child  link="${side}_gripper_narrow1_link"/>
      <axis xyz="0 0 -1"/>
      <limit lower="-0.805398163" upper="0.050752701" effort="20.0" velocity="1.0"/>
      <mimic joint="${jname}" multiplier="-6.801257207" offset="0.030752701"/>
    </joint>
    <!-- the SPRING link: FIXED at its stop (free motion) -->
    <link name="${side}_gripper_narrow2_link">
      <inertial>
        <origin xyz="0.0088027 -0.007035 1.6424e-05" rpy="0 0 0"/>
        <mass value="0.0040132"/>
        <inertia ixx="1.0307e-07" ixy="5.7851e-08" ixz="9.5801e-11" iyy="1.1385e-07" iyz="-2.81e-11" izz="1.7009e-07"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="package://moz1_description/meshes/gripper_narrow2.STL"/></geometry>
        <material name="moz1_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="package://moz1_description/meshes/gripper_narrow2.STL"/></geometry>
      </collision>
    </link>
    <joint name="${side}_gripper_narrow2_joint" type="fixed">
      <origin xyz="0.030852 0.018551 0" rpy="0 0 0"/>
      <parent link="${side}_gripper_narrow1_link"/>
      <child  link="${side}_gripper_narrow2_link"/>
    </joint>
    <!-- fingertip = the four-bar COUPLER -->
    <link name="${side}_gripper_narrow3_link">
      <inertial>
        <origin xyz="0.012508 -0.0079729 9.4339e-05" rpy="0 0 0"/>
        <mass value="0.018029"/>
        <inertia ixx="1.1403e-06" ixy="5.5159e-07" ixz="-4.0096e-13" iyy="2.5704e-06" iyz="1.0951e-12" izz="2.3252e-06"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="package://moz1_description/meshes/gripper_narrow3.STL"/></geometry>
        <material name="moz1_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="package://moz1_description/meshes/gripper_narrow3.STL"/></geometry>
      </collision>
    </link>
    <joint name="${side}_gripper_narrow3_joint" type="revolute">
      <origin xyz="0.018118 -0.01574 0" rpy="0 0 0"/>
      <parent link="${side}_gripper_narrow2_link"/>
      <child  link="${side}_gripper_narrow3_link"/>
      <axis xyz="0 0 -1"/>
      <limit lower="-0.100517101" upper="0.138972841" effort="20.0" velocity="1.0"/>
      <mimic joint="${jname}" multiplier="1.662416185" offset="-0.080517101"/>
    </joint>
    <!-- pin where bar 2 meets the fingertip (marker) -->
    <link name="${side}_gripper_narrow4_link"/>
    <joint name="${side}_gripper_narrow4_joint" type="fixed">
      <origin xyz="0 -0.0104 0" rpy="0 0 0"/>
      <parent link="${side}_gripper_narrow3_link"/>
      <child  link="${side}_gripper_narrow4_link"/>
    </joint>
    <link name="${side}_gripper_narrow_loop_link">
      <inertial>
        <origin xyz="0.014869 -0.0036066 0.00029307" rpy="0 0 0"/>
        <mass value="0.022591"/>
        <inertia ixx="4.3916e-06" ixy="1.114e-07" ixz="-4.9655e-12" iyy="4.737e-06" iyz="1.7121e-11" izz="6.0445e-07"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="package://moz1_description/meshes/gripper_narrow_loop.STL"/></geometry>
        <material name="moz1_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="package://moz1_description/meshes/gripper_narrow_loop.STL"/></geometry>
      </collision>
    </link>
    <joint name="${side}_gripper_narrow_loop_joint" type="revolute">
      <origin xyz="0 -0.021633 0.07387" rpy="-2.9951 -1.5708 -0.15964"/>
      <parent link="${side}_gripper_base_link"/>
      <child  link="${side}_gripper_narrow_loop_link"/>
      <axis xyz="0 0 -1"/>
      <limit lower="-1.213484588" upper="0.062258886" effort="20.0" velocity="1.0"/>
      <mimic joint="${jname}" multiplier="-10.297862281" offset="0.042258886"/>
    </joint>

    <!-- ===== wide finger ===== -->
    <link name="${side}_gripper_wide1_link">
      <inertial>
        <origin xyz="0.0095051 -0.0068479 6.8268e-05" rpy="0 0 0"/>
        <mass value="0.025428"/>
        <inertia ixx="1.9565e-06" ixy="4.2798e-07" ixz="2.3844e-10" iyy="2.3928e-06" iyz="-1.4454e-10" izz="1.5501e-06"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="package://moz1_description/meshes/gripper_wide1.STL"/></geometry>
        <material name="moz1_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="package://moz1_description/meshes/gripper_wide1.STL"/></geometry>
      </collision>
    </link>
    <joint name="${side}_gripper_wide1_joint" type="revolute">
      <origin xyz="0 0.0195 0.0565" rpy="-2.9951 -1.5708 -0.15964"/>
      <parent link="${side}_gripper_base_link"/>
      <child  link="${side}_gripper_wide1_link"/>
      <axis xyz="0 0 -1"/>
      <limit lower="-0.050752701" upper="0.805398163" effort="20.0" velocity="1.0"/>
      <mimic joint="${jname}" multiplier="6.801257207" offset="-0.030752701"/>
    </joint>
    <!-- the SPRING link: FIXED at its stop (free motion) -->
    <link name="${side}_gripper_wide2_link">
      <inertial>
        <origin xyz="0.0088027 0.007035 -1.6424e-05" rpy="0 0 0"/>
        <mass value="0.0040132"/>
        <inertia ixx="1.0307e-07" ixy="-5.7851e-08" ixz="-9.58e-11" iyy="1.1385e-07" iyz="-2.81e-11" izz="1.7009e-07"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="package://moz1_description/meshes/gripper_wide2.STL"/></geometry>
        <material name="moz1_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="package://moz1_description/meshes/gripper_wide2.STL"/></geometry>
      </collision>
    </link>
    <joint name="${side}_gripper_wide2_joint" type="fixed">
      <origin xyz="0.030852 -0.018551 0" rpy="0 0 0"/>
      <parent link="${side}_gripper_wide1_link"/>
      <child  link="${side}_gripper_wide2_link"/>
    </joint>
    <!-- fingertip = the four-bar COUPLER -->
    <link name="${side}_gripper_wide3_link">
      <inertial>
        <origin xyz="0.012508 0.0079729 9.4339e-05" rpy="0 0 0"/>
        <mass value="0.018029"/>
        <inertia ixx="1.1403e-06" ixy="-5.5159e-07" ixz="-4.0096e-13" iyy="2.5704e-06" iyz="-1.0951e-12" izz="2.3252e-06"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="package://moz1_description/meshes/gripper_wide3.STL"/></geometry>
        <material name="moz1_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="package://moz1_description/meshes/gripper_wide3.STL"/></geometry>
      </collision>
    </link>
    <joint name="${side}_gripper_wide3_joint" type="revolute">
      <origin xyz="0.018118 0.01574 0" rpy="0 0 0"/>
      <parent link="${side}_gripper_wide2_link"/>
      <child  link="${side}_gripper_wide3_link"/>
      <axis xyz="0 0 -1"/>
      <limit lower="-0.138972841" upper="0.100517101" effort="20.0" velocity="1.0"/>
      <mimic joint="${jname}" multiplier="-1.662416185" offset="0.080517101"/>
    </joint>
    <!-- pin where bar 2 meets the fingertip (marker) -->
    <link name="${side}_gripper_wide4_link"/>
    <joint name="${side}_gripper_wide4_joint" type="fixed">
      <origin xyz="0 0.0104 0" rpy="0 0 0"/>
      <parent link="${side}_gripper_wide3_link"/>
      <child  link="${side}_gripper_wide4_link"/>
    </joint>
    <link name="${side}_gripper_wide_loop_link">
      <inertial>
        <origin xyz="0.014869 0.0036066 0.00029307" rpy="0 0 0"/>
        <mass value="0.022591"/>
        <inertia ixx="4.3916e-06" ixy="-1.114e-07" ixz="-4.9655e-12" iyy="4.737e-06" iyz="-1.7121e-11" izz="6.0445e-07"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="package://moz1_description/meshes/gripper_wide_loop.STL"/></geometry>
        <material name="moz1_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="package://moz1_description/meshes/gripper_wide_loop.STL"/></geometry>
      </collision>
    </link>
    <joint name="${side}_gripper_wide_loop_joint" type="revolute">
      <origin xyz="0 0.021633 0.07387" rpy="-2.9951 -1.5708 -0.15964"/>
      <parent link="${side}_gripper_base_link"/>
      <child  link="${side}_gripper_wide_loop_link"/>
      <axis xyz="0 0 -1"/>
      <limit lower="-0.062258886" upper="1.213484588" effort="20.0" velocity="1.0"/>
      <mimic joint="${jname}" multiplier="10.297862281" offset="-0.042258886"/>
    </joint>

    <!-- ===== TCP - the grasp point =====
         On the gripper axis at the CLOSED pinch point, 139.8 mm out from the
         gripper body. Orientation matches the body, so +Z is the APPROACH
         direction: point this at the object and close.

         This is the MoveIt IK tip and the CartesianImpedanceController
         chain_tip. Before it existed both used ${side}_ee_link, the WRIST,
         so the RViz interactive marker sat at the wrist and every Cartesian
         target was ~140 mm short of the fingers.

         ⚠ Carries no geometry on purpose: a visual here would be picked up as
         a collision body between the jaws.
         ⚠ The pinch point MOVES with the opening (44 mm over the stroke, see
         TCP_Z in the generator). This frame is the CLOSED one. -->
    <link name="${side}_gripper_tcp_link"/>
    <joint name="${side}_gripper_tcp_joint" type="fixed">
      <origin xyz="0 0 0.139807" rpy="0 0 0"/>
      <parent link="${side}_gripper_base_link"/>
      <child  link="${side}_gripper_tcp_link"/>
    </joint>

  </xacro:macro>
</robot>
