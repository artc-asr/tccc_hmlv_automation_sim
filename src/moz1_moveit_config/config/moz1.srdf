    <!-- ===== chassis geometry (see scripts/check_srdf_links.py) =====
         `base_link` used to carry base_link.STL. It is now a PURE FRAME and the
         mesh hangs off `moz1_chassis`, which is rotated by visual_yaw so the nav
         stack keeps a MOZ1-convention base_link (moz1.urdf.xacro:93). The matrix
         was generated before that split, so every base_link pair below refers to
         an empty link while the real chassis geometry — parent of all four wheels
         and leg01 — had NO entry at all. Inherited here so planning behaviour is
         preserved. base_link's own pairs are kept: harmless, and correct again if
         it is ever given geometry back. -->
    <disable_collisions link1="base_footprint" link2="moz1_chassis" reason="Adjacent"/>
    <disable_collisions link1="head21" link2="moz1_chassis" reason="Never"/>
